# Configuração da produção (docker-compose.prod.yml). Na VM, o deploy/setup-vm.sh cria o .env.prod a
# partir deste modelo, já com senhas aleatórias. Nunca commite o .env.prod.

# Domínio público que aponta para o IP da VM (ex.: sigrest.duckdns.org). O HTTPS é emitido para ele.
SITE_DOMAIN=sigrest.duckdns.org

# Nome exibido no cabeçalho dos relatórios em PDF.
REPORT_COMPANY_NAME=Majú's Assados e Congelados

# Banco de dados (só acessível pela rede interna do Docker).
POSTGRES_DB=sigrest
POSTGRES_USER=sigrest
POSTGRES_PASSWORD=TROCAR

# Segredo de assinatura dos tokens de login.
JWT_SECRET=TROCAR

# Administrador criado no primeiro boot (troque a senha depois do primeiro acesso).
ADMIN_EMAIL=admin@majus.com.br
ADMIN_PASSWORD=TROCAR
